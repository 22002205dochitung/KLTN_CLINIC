# Bản build đưa lên host: giao diện và API chạy chung một tên miền (backend phục vụ cả hai)
# -> gọi API theo đường dẫn tương đối /api. Ghi đè địa chỉ localhost trong .env (chỉ dùng khi phát triển).
REACT_APP_API_BASE=/api
REACT_APP_API_URL=
# Không nhúng mã khởi động vào index.html
INLINE_RUNTIME_CHUNK=false
GENERATE_SOURCEMAP=false
