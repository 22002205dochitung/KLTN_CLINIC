# ==============================================================
#  THCT Clinic – cấu hình máy chủ (copy thành backend/.env)
#  Script setup-vps.sh tự điền các dòng có <...> – chỉ cần sửa tay nếu cài thủ công.
# ==============================================================

# ---- Chạy ----
NODE_ENV=production
PORT=5000
# Nginx đứng trước Node.js -> lấy IP thật của người dùng
TRUST_PROXY=1
# Tên miền của bạn (cho phép trình duyệt gọi API), nhiều tên miền cách nhau dấu phẩy
CORS_ORIGINS=https://<ten-mien>,https://www.<ten-mien>
# Để false khi còn thử bằng http://<IP>; đổi thành true sau khi cài SSL (https)
HTTPS_ONLY=false

# ---- Database (MariaDB trên chính VPS) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=thct
DB_PASSWORD=<mat-khau-database>
DB_NAME=kltn_clinic
# Chỉ bật khi dùng database đám mây bắt buộc SSL (TiDB Cloud, ...)
DB_SSL=false

# ---- Bảo mật đăng nhập ----
# Chuỗi ngẫu nhiên dài (script tự tạo). Đổi chuỗi này = mọi người phải đăng nhập lại.
JWT_SECRET=<chuoi-ngau-nhien-64-ky-tu>
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12
# Chặn dò mật khẩu: 5 lần sai / 15 phút (mặc định của production)
AUTH_RATE_LIMIT_MAX=5
ACCOUNT_LOCK_MAX_ATTEMPTS=5

# ---- Đặt lịch ----
SLOT_CAPACITY=10
AVG_EXAM_MINUTES=10
CLINIC_CLOSED_WEEKDAYS=0
PAYMENT_HOLD_MINUTES=15

# ---- Chuyển khoản VietQR (MB Bank của bạn) ----
BANK_BIN=970422
BANK_ACCOUNT_NO=0398266899
BANK_ACCOUNT_NAME=DO CHI TUNG
BANK_NAME=MB Bank
# Tự xác nhận chuyển khoản qua SePay (webhook: https://<ten-mien>/api/payments/webhook/sepay)
SEPAY_API_KEY=

# ---- Cổng thanh toán SePay (thẻ / VietQR / NAPAS, xác nhận tự động) ----
# Lấy ở my.sepay.vn > Cổng thanh toán > Thông tin tích hợp. Test: sandbox + SP-TEST-... / spsk_test_...
# Thật: production + MERCHANT ID / SECRET KEY chính thức. Để trống = ẩn nút "Thanh toán online qua SePay".
# URL IPN khai báo trong SePay: https://<ten-mien>/api/payments/sepay/ipn
SEPAY_PG_ENV=sandbox
SEPAY_PG_MERCHANT_ID=
SEPAY_PG_SECRET_KEY=
# Tuỳ chọn: khoá IPN (Auth type SECRET_KEY trong tab IPN), SePay gửi trong header X-Secret-Key
SEPAY_PG_IPN_SECRET=

# ---- Email OTP đăng ký ----
# Bắt buộc trên host thật: không có SMTP thì người dùng mới KHÔNG nhận được mã OTP.
# Gmail: bật xác minh 2 bước -> tạo "Mật khẩu ứng dụng" -> dán vào SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=THCT Clinic <email-cua-ban@gmail.com>
# Chưa có SMTP mà vẫn muốn cho đăng ký: đặt REGISTRATION_OTP=0 (bỏ bước OTP)
REGISTRATION_OTP=1

# ---- Loa gọi số giọng nữ miền Nam (tuỳ chọn) ----
FPT_TTS_API_KEY=
TTS_VOICE=lannhi
TTS_SPEED=0
